    "@vercel/speed-insights": "2.0.0",
    "gsap": "3.15.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query-devtools": "5.104.1",
    "@testing-library/dom": "10.4.2",
